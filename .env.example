# Copia este archivo como ".env" (en esta misma carpeta) y ajusta los valores.
# Lo leen tanto la web (PHP) como el ETL (Node.js). NO lo subas a repositorios públicos.

# Conexión a MySQL/MariaDB de XAMPP (por defecto: usuario root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meteo_aemet
DB_USER=root
DB_PASSWORD=

# Clave de AEMET OpenData (la usa el ETL). Solicítala en https://opendata.aemet.es
AEMET_API_KEY=pega_aqui_tu_api_key